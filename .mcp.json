{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless",
        "--no-sandbox",
        "--isolated",
        "--executable-path",
        "/opt/pw-browsers/chromium"
      ],
      "env": {}
    }
  }
}