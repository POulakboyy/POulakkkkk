{
  "name": "@pouxis/core",
  "version": "0.1.0",
  "description": "Moteur de domaine de POuxis : temps, planification, tâches, CRDT, idéation, graphes. Pur TypeScript, sans dépendance, multi-plateforme.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p bench",
    "bench": "node bench/run.ts",
    "bench:vitest": "vitest bench --run --config bench/vitest.config.ts --reporter=verbose"
  }
}
